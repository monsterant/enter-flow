#!/usr/bin/env bash
# 지금 작업 폴더 전체(git이 아직 모르는 새 파일 포함)를 git 트리로 찍고 트리 해시를 출력한다.
#
# 왜 커밋 대신 스냅샷인가: run-plan은 계획의 커밋 경계에서만 커밋한다. 그래서 단계마다
# 커밋이 생기지 않고, 원본처럼 BASE..HEAD 커밋 범위로 "이 단계에서 바뀐 것"을 잘라낼 수 없다.
# 단계 시작 전·후에 이 스크립트로 트리를 찍어 두면 `git diff <전> <후>`가 그 단계의 변경만 보여 준다.
#
# 실제 인덱스(스테이징)와 작업 파일은 건드리지 않는다. 임시 인덱스 파일에만 `git add -A`를 한다.
# .gitignore·.git/info/exclude 대상(.run-plan/, .enter-flow/ 등)은 트리에 들어가지 않는다.
# 찍은 트리는 어디에도 연결되지 않은 git 객체라, 나중에 git gc가 알아서 지운다.
#
# Usage: snapshot
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

tmp_index=$(mktemp)
trap 'rm -f "$tmp_index"' EXIT

# 현재 인덱스를 시작점으로 복사하면 add -A가 바뀐 파일만 다시 읽어서 빠르다.
# 인덱스가 없으면(커밋이 하나도 없는 레포 등) 빈 파일을 지운다: git은 0바이트 인덱스를 손상으로 본다.
real_index=$(git rev-parse --git-path index)
if [ -f "$real_index" ]; then
  cp "$real_index" "$tmp_index"
else
  rm -f "$tmp_index"
fi

# Windows(core.autocrlf)에서 파일마다 나오는 줄바꿈 경고를 끈다. 트리 내용에는 영향이 없다.
GIT_INDEX_FILE="$tmp_index" git -c core.safecrlf=false add -A
GIT_INDEX_FILE="$tmp_index" git write-tree
